<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Keycloak.Net.Core" Version="1.0.32" />
        <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.1" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.1" />
    </ItemGroup>

    <ItemGroup>
        <Compile Remove="TokenValidationParametersCreator.cs" />
        <Compile Remove="JwtClaimsPrincipalGetter.cs" />
    </ItemGroup>

    <ItemGroup>
        <None Update="shared.settings.Development.json">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <EmbeddedResource Include="shared.settings.Development.json" />
    </ItemGroup>

</Project>
