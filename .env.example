# ProdPlace Docker Environment Configuration
# ============================================
# Copy to .env and customize values

# Database Credentials (MSSQL)
MSSQL_SA_PASSWORD=your_mssql_password
SA_PASSWORD=your_mssql_password

# Database Credentials (PostgreSQL)
POSTGRES_USER=admin
POSTGRES_PASSWORD=your_postgres_password

# RabbitMQ
RABBITMQ_DEFAULT_USER=admin
RABBITMQ_DEFAULT_PASS=your_rabbitmq_password

# Keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=your_keycloak_admin_password
KC_DB_USERNAME=keycloak_db_user
KC_DB_PASSWORD=your_keycloak_db_password

# MongoDB
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=your_mongo_password
